`import $binding from $path` where {
  or {
    $path <: `"./WordTextLocatorAdapter"`,
    $path <: `"../word/WordTextLocatorAdapter"`,
    $path <: `"../../word/WordTextLocatorAdapter"`,
    $path <: `"../domain/text-search/$_"`,
    $path <: `"../../domain/text-search/$_"`,
    $path <: `"../../../domain/text-search/$_"`,
    $path <: `"../core/text-search/$_"`,
    $path <: `"../../core/text-search/$_"`,
    $path <: `"../../../core/text-search/$_"`
  },
  register_diagnostic(span=$path, message="Concrete text-search implementations must not be imported here. Depend on an authorized locator port or orchestrator instead.", severity="error")
}
