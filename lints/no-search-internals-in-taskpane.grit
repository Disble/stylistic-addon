`import $binding from $path` where {
  or {
    $path <: `"../adapters/word/WordTextLocatorAdapter"`,
    $path <: `"../adapters/word/resolution/$_"`,
    $path <: `"../domain/text-search/$_"`,
    $path <: `"../core/text-search/$_"`,
    $path <: `"../../adapters/word/WordTextLocatorAdapter"`,
    $path <: `"../../adapters/word/resolution/$_"`,
    $path <: `"../../domain/text-search/$_"`,
    $path <: `"../../core/text-search/$_"`,
    $path <: `"../../../adapters/word/WordTextLocatorAdapter"`,
    $path <: `"../../../adapters/word/resolution/$_"`,
    $path <: `"../../../domain/text-search/$_"`,
    $path <: `"../../../core/text-search/$_"`
  },
  register_diagnostic(span=$path, message="Taskpane and workflow layers must not import text-search internals directly. Depend on ports, mediator workflows, or document services instead.", severity="error")
}
