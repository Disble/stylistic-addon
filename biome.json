{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/tests",
      "!**/*.test.ts",
      "!**/*.spec.ts",
      "!**/*TestHelper.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["PascalCase", "camelCase"],
            "requireAscii": true
          }
        },
        "noNonNullAssertion": {
          "level": "off"
        }
      },
      "suspicious": {
        "noExplicitAny": {
          "level": "warn"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/domain/**", "src/infrastructure/**", "src/taskpane/**"],
      "plugins": ["./lints/no-word-global.grit"]
    },
    {
      "includes": ["src/domain/**"],
      "plugins": ["./lints/no-adapter-import-in-domain.grit"]
    },
    {
      "includes": [
        "src/adapters/word/**",
        "!src/adapters/word/WordTextLocatorAdapter.ts",
        "!src/adapters/word/WordTextLocatorContext.ts"
      ],
      "plugins": ["./lints/no-concrete-text-search-import.grit"]
    },
    {
      "includes": [
        "src/**",
        "!src/domain/text-search/**",
        "!src/core/text-search/**"
      ],
      "plugins": ["./lints/no-search-primitive-redefinition.grit"]
    },
    {
      "includes": ["src/domain/**", "src/taskpane/**"],
      "plugins": ["./lints/no-search-internals-in-taskpane.grit"]
    }
  ]
}
