{
  "compilerOptions": {
    "allowJs": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react",
    "noEmitOnError": true,
    "outDir": "lib",
    "sourceMap": true,
    "target": "es2016",
    "lib": ["es2016", "dom"],
    "types": ["office-js", "office-runtime", "vitest/globals"],
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist", "lib", "lib-amd"],
  "ts-node": {
    "files": true
  }
}
