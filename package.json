{
  "name": "office-addin-taskpane",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/OfficeDev/Office-Addin-TaskPane.git"
  },
  "license": "MIT",
  "config": {
    "app_to_debug": "word",
    "app_type_to_debug": "desktop",
    "dev_server_port": 3000
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prettier": "office-addin-lint prettier",
    "check:architecture-rails": "node scripts/checkArchitectureRails.mjs",
    "check:filenames": "node scripts/checkFileNaming.mjs",
    "check:complexity": "node scripts/checkComplexity.mjs",
    "check:react-rails": "node scripts/checkReactComponentRails.mjs",
    "validate": "bun run lint && bun run check:architecture-rails && bun run check:filenames && bun run check:complexity && bun run check:react-rails && bun run typecheck",
    "hooks:install": "lefthook install",
    "hooks:pre-commit": "lefthook run pre-commit",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "manifest:validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.55.1",
    "@fluentui/react-icons": "^2.0.264",
    "@mastra/client-js": "^1.7.1",
    "better-auth": "^1.6.9",
    "core-js": "^3.36.0",
    "es6-promise": "^4.2.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "regenerator-runtime": "^0.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@types/office-js": "^1.0.589",
    "@types/office-runtime": "^1.0.36",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^4.0.18",
    "acorn": "^8.11.3",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.39.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-office-addins": "^4.0.3",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-vitest": "^0.5.4",
    "file-loader": "^6.2.0",
    "globals": "^17.6.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.7",
    "lefthook": "^2.1.6",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "office-addin-cli": "^2.0.7",
    "office-addin-debugging": "^6.0.7",
    "office-addin-dev-certs": "^2.0.7",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "^2.1.3",
    "office-addin-prettier-config": "^2.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.18",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "5.2.3"
  },
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ],
  "prettier": "office-addin-prettier-config"
}
